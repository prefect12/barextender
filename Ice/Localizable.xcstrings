      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活预设"
          }
        }
      }
    },
    "Add a trigger to activate a preset or show menu bar items when its conditions are met.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加触发器；满足条件时即可激活预设或显示菜单栏项目。"
