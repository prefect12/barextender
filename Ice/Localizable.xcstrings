    "A Barextender release feed must be configured before automatic updates can be enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须先配置 Barextender 发布源，才能启用自动更新。"
          }
        }
      }
    },
    "Absolutely no personal information is collected or stored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Barextender 不会收集或存储任何个人信息。"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
